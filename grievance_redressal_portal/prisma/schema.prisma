// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// moduleformat = "cjs" added to circumvent prisma bug in mixed commonjs projects.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
	open
	locked
	resolved
	suspended
	archived

	@@map("post_status_enum")
}

model Post {
	post_id                Int          @id @default(autoincrement())
	post_date_created_at   DateTime     @default(now()) @db.Timestamptz
	post_title             String       @db.VarChar(500) @default("DEFAULT POST TITLE")
	post_content           String       @db.VarChar(20000)
	user_id                Int       
	post_status            PostStatus   @default(open)
	user                   User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
	images                 Image[]
	comments               Comment[]

	@@map("posts")                 
}

model Image {
	image_id                Int          @id @default(autoincrement())
	image_date_created_at   DateTime     @default(now()) @db.Timestamptz
	image_path              String       @db.VarChar(256)
	image_tag               String?      @db.VarChar(1000)
	post_id                 Int
	post                    Post         @relation(fields: [post_id], references: [post_id], onDelete: Cascade)  

	@@map("images")  
}

model Comment {
	comment_id                Int          @id @default(autoincrement())
	comment_date_created_at   DateTime     @default(now()) @db.Timestamptz
	comment_content           String       @db.VarChar(20000)
	comment_is_deleted        Boolean      @default(false)
	post_id                   Int
	user_id                   Int
	parent_id                 Int?
	post                      Post         @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
	user                      User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
	reply                     Comment?     @relation("CommentReplies", fields: [parent_id], references: [comment_id], onDelete: SetNull)
	replies                   Comment[]    @relation("CommentReplies")

	@@map("comments")
}

enum UserRole {
  company_employee
  company_manager
  restaurant_employee
  restaurant_manager
  chain_manager

  @@map("user_role_enum")
}

enum UserStatus {
  active
  suspended

  @@map("user_status_enum")
}

model User {
    user_id                                      Int         @id @default(autoincrement())
	user_date_created_at                         DateTime    @default(now()) @db.Timestamptz
	user_first_name                              String      @db.VarChar(100)
	user_last_name                               String?     @db.VarChar(100)
	user_password                                String      @db.VarChar(100)
	user_email                                   String      @unique @db.VarChar(100)
	user_dob                                     DateTime    @db.Date
	user_role                                    UserRole
	user_address_room_no                         String?     @db.VarChar(5)
	user_address_building                        String?     @db.VarChar(50)
	user_address_street                          String      @db.VarChar(100)
	user_address_city                            String      @db.VarChar(100)
	user_address_admin_division                  String?     @db.VarChar(100)
	user_address_country                         String      @db.VarChar(100)
	user_address_post_code                       String      @db.VarChar(12)
	outlet_id                                    Int?
    outlet                                       Outlet?     @relation(fields: [outlet_id], references: [outlet_id], onDelete: SetNull)    
	user_mobile_no                               String      @unique @db.VarChar(12)
	user_is_moderator                            Boolean     @default(false)
    user_status                                  UserStatus  @default(active)
	posts                                        Post[]
	comments                                     Comment[]

    @@map("users")
}

model Chain {
  chain_id                                    Int       @id @default(autoincrement())
  chain_date_created_at                       DateTime  @default(now()) @db.Timestamptz
  chain_name                                  String    @unique @db.VarChar(100)
  chain_headquarters_address_room_no          String?   @db.VarChar(5)
  chain_headquarters_address_building         String?   @db.VarChar(50)
  chain_headquarters_address_street           String    @db.VarChar(100)
  chain_headquarters_address_city             String    @db.VarChar(100)
  chain_headquarters_address_admin_division   String?   @db.VarChar(100)
  chain_headquarters_address_country          String    @db.VarChar(100)
  chain_headquarters_address_post_code        String    @db.VarChar(12)
  outlets                                     Outlet[]

  @@map("chains")
}

model Outlet {
  outlet_id                       Int       @id @default(autoincrement())
  outlet_date_created_at          DateTime  @default(now()) @db.Timestamptz
  outlet_name                     String    @unique @db.VarChar(100)
  outlet_address_room_no          String?   @db.VarChar(5)
  outlet_address_building         String?   @db.VarChar(50)
  outlet_address_street           String    @db.VarChar(100)
  outlet_address_city             String    @db.VarChar(100)
  outlet_address_admin_division   String?   @db.VarChar(100)
  outlet_address_country          String    @db.VarChar(100)
  outlet_address_post_code        String    @db.VarChar(12)
  chain_id                        Int?
  chain                           Chain?    @relation(fields: [chain_id], references: [chain_id], onDelete: Restrict)
  users                           User[]

  @@map("outlets")
}
